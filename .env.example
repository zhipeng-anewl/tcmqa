# 复制为 .env，填入你自己的 key。.env 已在 .gitignore 中，不会提交。

# ---- 必填：LLM ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ---- 必填：Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password

# ---- 可选：检索参数 ----
# 向量召回条数 / BM25 召回条数 / RRF 融合后保留条数
VECTOR_TOP_K=8
BM25_TOP_K=8
FUSE_TOP_K=6
# Text2Cypher 失败后最多重写几次
CYPHER_MAX_REPAIR=2

# ---- 可选：缓存 ----
CACHE_TTL_SECONDS=3600
# 语义缓存余弦阈值，越高越保守
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- 可选：Embedding ----
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# 国内网络访问 huggingface 需要镜像
HF_ENDPOINT=https://hf-mirror.com

# ---- 可选：服务 ----
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---- 可选：图片原始目录（不在仓库内，按机器配置）----
# 不配也能跑：封面与缩略图在 data/images 里，只有"看大图"和"分子结构图"会不可用
HERB_IMAGE_ROOT=
MOL_IMAGE_ROOT=
