# 生产环境配置：复制为 deploy/.env 后填值（该文件已被 .gitignore 忽略，不会提交）
#
#   cp .env.example .env

# ---- 必填：大模型 ----
# 公网演示建议单独申请一个 key，并设置消费限额，别用自己开发用的那张
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 必填：Neo4j 密码（首次初始化后不要改，改了容器里的库还是旧密码）----
NEO4J_PASSWORD=change-me-please

# ---- 访问地址 ----
# 有域名：tcm.example.com（需先解析到本机，Caddy 自动签 HTTPS）
# 只有 IP：:80（先用 http://服务器IP 验收，域名备案后再换）
SITE_ADDRESS=:80

# ---- 成本控制 ----
# 单 IP 每分钟最多几次问答；0 表示关闭
RATE_LIMIT_PER_MINUTE=6
# 全站每天最多几次问答；0 表示不限额
DAILY_CHAT_LIMIT=800
