# 反代配置，配合 docker-compose.prod.yml 使用。
#
# SITE_ADDRESS 来自 deploy/.env：
#   有域名（tcm.example.com）→ Caddy 自动申请并续期 Let's Encrypt 证书
#   :80                    → 只走 HTTP，方便用 http://服务器IP 先验收

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# flush_interval -1 是 SSE 流式回答的关键。
	# 反代默认会攒一批再发，导致「打字机效果」变成「等几秒一次性蹦出全文」。
	reverse_proxy api:8000 {
		flush_interval -1
	}
}
